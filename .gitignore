# ---- Unity generated ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Assets/, Packages/, ProjectSettings/ — those are the project.

# Asset meta files for ignored folders
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Unity3D generated project files (regenerated by the editor / IDE)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D crash / stack traces
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Visual Studio / Rider / VS Code caches
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Editor screenshots / capture output
[Cc]aptures/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# ---- Python training side ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Training run output (large; regenerate with training/train_run.py)
training/logs/
training/checkpoints/
*.pt
*.pth
*.ckpt
