<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-race HUD: one row of controls along the bottom, and the developer stats as a strip of badges
    directly above it.

    One row, four buttons. The viewer's three disturbances (GUST, SHOVE, SLICK) sit behind one CHAOS button
    and pop up in a row of their own above it when it is pressed, so the row carries four targets a thumb
    can hit rather than six. RESTART is a plain button, not the green one, and asks for a second tap: it
    was the brightest thing on the screen in the middle of a race, and one stray touch threw the race away.

    The stats are badges, not a card. In a broadcast scene they are not shown here at all: STATS puts the
    developer line on the broadcast card for whoever is on camera, which is the athlete the viewer is
    already looking at. The strip is only for the hands-on development scenes, which have no overlay.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore">

            <ui:VisualElement class="spacer" picking-mode="Ignore" />

            <ui:VisualElement name="stats-card" class="badge-strip hidden" picking-mode="Ignore">
                <ui:Label name="model" class="badge-model" text="-" picking-mode="Ignore" />
                <ui:VisualElement class="badge-row" picking-mode="Ignore">
                    <ui:Label name="speed" class="badge" text="0.00 m/s" picking-mode="Ignore" />
                    <ui:Label name="distance" class="badge" text="0 m" picking-mode="Ignore" />
                    <ui:Label name="stability" class="badge" text="100%" picking-mode="Ignore" />
                    <ui:Label name="attempt" class="badge" text="#1" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="last-result" class="badge-model" text="" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- The disturbances, popped up by CHAOS. The words count down while each is cooling off. -->
            <ui:VisualElement name="chaos-pop" class="chaos-pop hidden">
                <ui:Button name="gust" class="btn btn--tool">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/fastForward.png');" />
                    <ui:Label name="gust-label" class="btn-label" text="GUST" />
                </ui:Button>
                <ui:Button name="shove" class="btn btn--tool">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/exclamation.png');" />
                    <ui:Label name="shove-label" class="btn-label" text="SHOVE" />
                </ui:Button>
                <ui:Button name="slick" class="btn btn--tool">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/warning.png');" />
                    <ui:Label name="slick-label" class="btn-label" text="SLICK" />
                </ui:Button>
            </ui:VisualElement>

            <!--
                The viewer's hand on the race (only in the broadcast scenes: HudView shows the group when a
                ViewerChaos or a director is wired), then the race's own controls.
            -->
            <ui:VisualElement name="control-bar" class="control-bar">
                <ui:VisualElement name="chaos-bar" class="chaos-group hidden">
                    <ui:Button name="chaos" class="btn btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/warning.png');" />
                        <ui:Label name="chaos-label" class="btn-label" text="CHAOS" />
                    </ui:Button>
                    <ui:Button name="cam" class="btn btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/movie.png');" />
                        <ui:Label name="cam-label" class="btn-label" text="AUTO" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:Button name="restart" class="btn btn--ghost btn--tool">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/return.png');" />
                    <ui:Label name="restart-label" class="btn-label" text="RESTART" />
                </ui:Button>
                <ui:Button name="stats" class="btn btn--ghost btn--tool">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/barsVertical.png');" />
                    <ui:Label class="btn-label" text="STATS" />
                </ui:Button>
                <ui:Button name="slowmo" class="btn btn--ghost btn--tool hidden" text="0.5x" />
                <ui:Button name="camera" class="btn btn--ghost btn--tool hidden" text="CAM" />
                <ui:Button name="menu" class="btn btn--ghost btn--tool" text="MENU" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
