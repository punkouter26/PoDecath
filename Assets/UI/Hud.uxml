<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-race HUD: a developer stats card that a broadcast scene keeps put away behind the STATS button,
    and the control bar along the bottom.

    The card is the second view of a race, not the first. The broadcast overlay carries the event; this is
    what you open to see how a policy is actually doing — speed, stability, which checkpoint is driving.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore" style="padding: 16px;">

            <ui:VisualElement class="spacer" picking-mode="Ignore" />

            <ui:VisualElement name="stats-card" class="card stats hidden">
                <ui:Label name="model" class="label-small" text="-" style="margin-bottom: 8px;" />
                <ui:VisualElement class="stat-line">
                    <ui:Label class="stat-key" text="Speed" />
                    <ui:Label name="speed" class="stat-value" text="0.00 m/s" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-line">
                    <ui:Label class="stat-key" text="Distance" />
                    <ui:Label name="distance" class="stat-value" text="0 m" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-line">
                    <ui:Label class="stat-key" text="Stability" />
                    <ui:Label name="stability" class="stat-value" text="100 %" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-line">
                    <ui:Label class="stat-key" text="Attempt" />
                    <ui:Label name="attempt" class="stat-value" text="1" />
                </ui:VisualElement>
                <ui:Label name="last-result" class="label-micro" text="" style="margin-top: 8px;" />
            </ui:VisualElement>

            <!--
                The viewer's hand on the race: three physical disturbances and the camera picker. Only in the
                broadcast scenes (HudView shows it when a ViewerChaos or a director is wired). Each button is an
                icon over a word; the word counts down while the button is cooling off.
            -->
            <ui:VisualElement name="chaos-bar" class="chaos-bar hidden">
                <ui:Button name="gust" class="btn btn--icon">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/fastForward.png');" />
                    <ui:Label name="gust-label" class="btn-label" text="GUST" />
                </ui:Button>
                <ui:Button name="shove" class="btn btn--icon">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/exclamation.png');" />
                    <ui:Label name="shove-label" class="btn-label" text="SHOVE" />
                </ui:Button>
                <ui:Button name="slick" class="btn btn--icon">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/warning.png');" />
                    <ui:Label name="slick-label" class="btn-label" text="SLICK" />
                </ui:Button>
                <ui:Button name="cam" class="btn btn--icon">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/movie.png');" />
                    <ui:Label name="cam-label" class="btn-label" text="AUTO" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="control-bar" class="control-bar">
                <ui:Button name="restart" class="btn btn--primary" text="RESTART" />
                <ui:Button name="stats" class="btn btn--ghost" text="STATS" />
                <ui:Button name="slowmo" class="btn btn--ghost hidden" text="0.5x" />
                <ui:Button name="camera" class="btn btn--ghost hidden" text="CAM" />
                <ui:Button name="menu" class="btn btn--ghost" text="MENU" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
