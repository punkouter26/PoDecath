<?xml version="1.0" encoding="utf-8"?>
<!--
    The card that comes up once every runner has finished or fallen. Rows are built in ResultsView from
    DashEvent.Results, so a field of two and a field of sixteen both fit without a pre-built row per slot.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root hidden">
        <ui:VisualElement name="scrim" class="modal-scrim">
            <ui:VisualElement name="modal" class="modal modal--out">
                <ui:Label name="title" class="label-display" text="RESULTS" />
                <ui:Label name="subtitle" class="label-small muted" text="" style="margin-bottom: 24px;" />

                <ui:ScrollView name="rows-scroll" style="flex-grow: 1;">
                    <ui:VisualElement name="rows" />
                </ui:ScrollView>

                <ui:VisualElement class="row" style="margin-top: 24px;">
                    <ui:Button name="again" class="btn btn--primary" text="RACE AGAIN" style="flex-grow: 1; margin-right: 8px;" />
                    <ui:Button name="change" class="btn btn--ghost" text="CHANGE FIELD" style="flex-grow: 1; margin-left: 8px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
