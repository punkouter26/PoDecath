<?xml version="1.0" encoding="utf-8"?>
<!--
    The diagnostics sheet, opened by DEBUG in the bottom-left of the frame, by tapping the frame rate in the
    top-centre, or F3 on a desktop. DEBUG (or the frame rate, or F3) closes it again.

    Two pages:

      LIVE      the athletes, one line each, and under them the device: the frame-time graph and every
                frame counter in a grid. Tap an athlete's line for its full card (which ONNX is driving it,
                twelve numbers, ninety seconds of trend, and one sentence saying what to change), BACK for
                the list. A line with something wrong on it carries a "!" and its colour; the sentence is on
                its card. These were two pages, AGENTS and FRAME, and AGENTS was half empty.
      SETTINGS  the quality tier and the frame-rate target.

    Nothing here scrolls. Past eight athletes the lines go compact, so sixteen still leave room for the
    frame grid.

    The sheet and its scrim stop at the frame's rows top and bottom, so MENU, DEBUG, the frame rate and the
    version stay on the picture and DEBUG closes what it opened.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root hidden">
        <ui:VisualElement name="scrim" class="sheet-scrim" />
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore">
            <ui:VisualElement name="panel" class="sheet">

                <ui:VisualElement class="sheet-head">
                    <ui:VisualElement class="sheet-tabs">
                        <ui:Button name="tab-live" class="tab tab--on" text="LIVE" />
                        <ui:Button name="tab-settings" class="tab" text="SETTINGS" />
                    </ui:VisualElement>
                    <ui:Button name="export" class="btn btn--ghost btn--chip btn--icon-only">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/share1.png');" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- The field in one sentence (or, when one athlete is at fault, how many); where an export went. -->
                <ui:Label name="title" class="sheet-summary" text="" />

                <ui:VisualElement name="body" class="sheet-body">

                    <ui:VisualElement name="live-page">
                        <ui:VisualElement name="agents" />
                        <ui:VisualElement name="agent-detail" class="hidden">
                            <ui:Button name="agent-back" class="btn btn--ghost btn--chip agent-back" text="BACK TO THE FIELD" />
                            <ui:VisualElement name="agent-card" />
                        </ui:VisualElement>

                        <ui:VisualElement name="frame-section" class="frame-section">
                            <ui:VisualElement name="graph" class="telemetry-graph" />
                            <ui:VisualElement name="rows" class="frame-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="settings-page" class="hidden">
                        <ui:Label class="label-micro" text="QUALITY TIER" style="margin-bottom: 8px;" />
                        <ui:VisualElement class="row settings-row">
                            <ui:Button name="tier-mobile" class="event-btn" text="MOBILE" />
                            <ui:Button name="tier-pc" class="event-btn" text="PC" />
                        </ui:VisualElement>
                        <ui:Label name="tier-note" class="agent-legend" text="" style="white-space: normal;" />

                        <ui:Label class="label-micro" text="FRAME-RATE TARGET" style="margin-top: 24px; margin-bottom: 8px;" />
                        <ui:VisualElement class="row settings-row">
                            <ui:Button name="fps-30" class="event-btn" text="30 FPS" />
                            <ui:Button name="fps-60" class="event-btn" text="60 FPS" />
                        </ui:VisualElement>

                        <ui:Label name="settings-info" class="agent-legend" text="" style="margin-top: 24px; white-space: normal;" />
                        <ui:Label name="footer" class="agent-legend" text="" style="margin-top: 8px; white-space: normal;" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
