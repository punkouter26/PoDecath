<?xml version="1.0" encoding="utf-8"?>
<!--
    The card that comes up once every runner has finished or fallen. Rows are built in ResultsView from
    DashEvent.Results, so a field of two and a field of sixteen both fit without a pre-built row per slot.

    No scrolling: a field past eight finishers switches to compact rows (ResultsView adds the compact
    modifier class to each row), so sixteen finishers still fit inside the modal on a portrait phone.

    One row per finisher, and one line for everybody who did not finish: four fallers used to be four
    full rows of "DNF fell at 92 m, 0 pts". The height that saves goes to each finisher's own numbers from
    the race (top speed, times back up off the deck, work done), which used to live only on the
    diagnostics sheet.

    The replay is the highlight clip of this race, looping full-bleed behind the card, so results and the
    replay are one screen rather than a file name on a line. REPLAY takes the card off it; a tap on the
    picture puts the card back. SHARE hands the saved clip to the phone's share sheet.

    Never write a double hyphen inside one of these comments. XML forbids it, the importer throws, and
    the whole file lands as an EMPTY VisualTreeAsset (0.2 kb, against 8 to 16 kb for the other screens),
    so every lookup in ResultsView fails and the results card silently never appears. That is exactly
    how this file shipped: the compact row class name was spelled out in full here, two hyphens and all,
    and it cost the game its entire end of race screen.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root hidden">
        <ui:VisualElement name="replay" class="replay hidden" />
        <ui:VisualElement name="scrim" class="modal-scrim">
            <!-- The safe area, so a tall card (sixteen finishers and the season table) stops short of the
                 notch, the home bar and the frame's MENU and DEBUG rows. The scrim and the replay stay full bleed. -->
            <ui:VisualElement name="safe" class="safe results-safe">
            <ui:VisualElement name="modal" class="modal modal--out">
                <ui:Label name="title" class="label-display" text="RESULTS" />
                <ui:Label name="subtitle" class="label-small muted" text="" style="margin-bottom: 16px;" />

                <!-- The photo finish: time runs left to right, a tick where each of the first three bodies crossed the painted line. Built
                     by PhotoFinish on the line; hidden when there is none, or when the board is already full. -->
                <ui:VisualElement name="photo" class="photo-finish hidden">
                    <ui:VisualElement name="photo-strip" class="photo-strip" />
                    <ui:Label name="photo-caption" class="photo-caption" text="" />
                </ui:VisualElement>

                <ui:VisualElement name="rows" class="results-rows" />

                <!-- Everybody who did not finish: a face each, with the name and where they went down. Filled by ResultsView. -->
                <ui:VisualElement name="out" class="results-out hidden">
                    <ui:Label class="results-out-head" text="OUT" />
                    <ui:VisualElement name="out-faces" class="results-out-faces" />
                </ui:VisualElement>

                <!-- The season table, when this race was a leg of one. Filled by ResultsView from SeasonStore. -->
                <ui:VisualElement name="season" class="season-panel hidden">
                    <ui:VisualElement class="season-head">
                        <ui:VisualElement class="season-icon" />
                        <ui:Label name="season-title" class="season-title" text="SEASON" />
                    </ui:VisualElement>
                    <ui:VisualElement name="season-rows" />
                </ui:VisualElement>

                <!-- What SHARE did, or why there is no clip. Hidden until there is something to say. -->
                <ui:Label name="clip-text" class="clip-text hidden" text="" />

                <ui:VisualElement class="row results-actions">
                    <ui:Button name="next" class="btn btn--primary btn--tool hidden">
                        <ui:VisualElement class="btn-icon btn-icon--dark" style="background-image: url('project://database/Assets/UI/Icons/next.png');" />
                        <ui:Label name="next-label" class="btn-label btn-label--dark" text="NEXT" />
                    </ui:Button>
                    <ui:Button name="again" class="btn btn--primary btn--tool">
                        <ui:VisualElement class="btn-icon btn-icon--dark" style="background-image: url('project://database/Assets/UI/Icons/return.png');" />
                        <ui:Label class="btn-label btn-label--dark" text="AGAIN" />
                    </ui:Button>
                    <ui:Button name="watch" class="btn btn--ghost btn--tool hidden">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/video.png');" />
                        <ui:Label class="btn-label" text="REPLAY" />
                    </ui:Button>
                    <ui:Button name="share" class="btn btn--ghost btn--tool hidden">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/share1.png');" />
                        <ui:Label name="share-label" class="btn-label" text="SHARE" />
                    </ui:Button>
                    <ui:Button name="change" class="btn btn--ghost btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/multiplayer.png');" />
                        <ui:Label class="btn-label" text="FIELD" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
