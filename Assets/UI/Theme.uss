/*
 * PoDecath UI theme.
 *
 * One stylesheet for every screen: the setup menu, the in-race HUD, the broadcast overlay, the results
 * card and the diagnostics panel. Everything that used to be a hard-coded Color in RaceUiBuilder.cs is a
 * token here, so re-colouring the whole game is one block of text rather than a rebuild of four scenes.
 *
 * Two rules run through the whole thing:
 *
 *  - Spacing is on an 8 px grid at the 1080 x 1920 reference resolution. Every padding, margin and gap
 *    below is a multiple of 8 (or 4 for the tightest ones), which is what makes screens built by different
 *    parts of the codebase look like they belong to the same game.
 *
 *  - The broadcast furniture is thinner than the cards. It sits over the picture, and most of what is
 *    behind it is the sky over the roof, which is the brightest thing in the scene. Anything laid over
 *    that needs a real scrim behind it, not 50% black.
 */

:root {
    /* Ink */
    --ink:            rgb(240, 244, 249);
    --ink-dim:        rgb(168, 178, 192);
    --ink-faint:      rgb(116, 126, 140);

    /* Surfaces, darkest first */
    --scrim:          rgba(5, 7, 12, 0.92);
    --surface:        rgba(13, 16, 24, 0.94);
    --surface-2:      rgba(24, 29, 40, 0.96);
    --surface-line:   rgba(255, 255, 255, 0.08);
    --overlay:        rgba(6, 8, 14, 0.88);
    --overlay-strip:  rgba(6, 8, 14, 0.84);
    --row:            rgba(255, 255, 255, 0.05);
    --row-lead:       rgba(255, 255, 255, 0.11);

    /* Accents */
    --accent:         rgb(46, 191, 140);
    --accent-press:   rgb(32, 150, 110);
    --danger:         rgb(255, 108, 92);
    --warn:           rgb(255, 198, 84);

    /* Type scale.
     *
     * Sized for a phone held in portrait, not for a maximised Game view. The reference resolution is
     * 1080 wide, and a 1080-wide phone is around 2.6 device pixels to the CSS pixel, so a reference px is
     * roughly 0.38 dp: the old 18px "micro" landed at about 7 dp on a Pixel, which is below the size at
     * which Android's own accessibility guidance says text stops being readable (12 sp, ~31 reference px
     * at width match).
     *
     * So the floor here is 26px, and that is only used for letter-spaced ALL-CAPS section labels and the
     * telemetry keys, which read a size larger than their nominal height. Everything that carries a
     * sentence or a number a person has to act on is --t-small (32px, ~12 sp) or above. Row heights and
     * fixed column widths below were re-measured against this scale; changing it means re-measuring them.
     */
    --t-micro:        26px;
    --t-small:        32px;
    --t-body:         38px;
    --t-title:        48px;
    --t-display:      64px;
    --t-clock:        74px;

    /* Grid */
    --gap-1:           8px;
    --gap-2:          16px;
    --gap-3:          24px;
    --gap-4:          32px;
    --gap-5:          48px;

    /* The frame's row height (AppFrameView.RowHeight) and that plus a gap, which is what any screen
       anchoring content to the bottom of the display has to pad itself by to stay out from under DEBUG
       and the version. It is a token because three screens need it and the frame is in a different
       UIDocument, so none of them can measure it. */
    --frame-row:     112px;
    --frame-clear:   144px;
    /* The top of anything drawn under the frame's top row: the row plus one grid step. */
    --frame-top-clear: 120px;

    --radius:         12px;
    --radius-sm:       8px;
}

/* ------------------------------------------------------------------ base */

.root {
    flex-grow: 1;
    color: var(--ink);
    font-size: var(--t-body);
}

/* Every screen sits inside this: it is the safe area, applied in code from Screen.safeArea. */
.safe {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.fill { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.spacer { flex-grow: 1; }
.hidden { display: none; }

.card {
    background-color: var(--surface);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-3);
}

.muted { color: var(--ink-dim); }
.faint { color: var(--ink-faint); }
.danger { color: var(--danger); }
.warn { color: var(--warn); }

.label-micro { font-size: var(--t-micro); letter-spacing: 2px; color: var(--ink-dim); }
.label-small { font-size: var(--t-small); }
.label-title { font-size: var(--t-title); -unity-font-style: bold; }
.label-display { font-size: var(--t-display); -unity-font-style: bold; }

/* Numbers that change every frame — clocks, splits, speeds — are tabular by hand: a fixed width per
   field stops the whole row jittering sideways as a digit changes. */
.numeric {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* ------------------------------------------------------------------ buttons */

.btn {
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-width: 0;
    color: var(--ink);
    font-size: var(--t-body);
    padding: var(--gap-2) var(--gap-3);
    margin: 0;
    min-height: 88px;                  /* a 44 pt touch target at 2x, which is the floor on a phone */
    transition-property: background-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn:hover { background-color: rgba(46, 191, 140, 0.18); }
.btn:active { scale: 0.97 0.97; background-color: var(--accent-press); }
.btn:disabled { opacity: 0.35; }

.btn--primary { background-color: var(--accent); color: rgb(6, 20, 15); -unity-font-style: bold; }
.btn--primary:hover { background-color: rgb(60, 210, 156); }

.btn--ghost { background-color: rgba(255, 255, 255, 0.06); }

/* Small secondary action that sits on a line beside text rather than owning a row of its own. */
.btn--chip {
    min-height: 72px;
    padding-left: var(--gap-3);
    padding-right: var(--gap-3);
    margin-left: var(--gap-2);
    font-size: var(--t-small);
}

.btn--step {
    /* A stepper sits on a row that is already --surface-2, so it needs its own lighter ground or it
       disappears into the row and reads as two floating glyphs. */
    min-width: 96px;
    min-height: 88px;
    width: 96px;
    margin-left: 8px;
    font-size: 44px;
    -unity-font-style: bold;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.10);
    color: var(--ink);
}

.btn--step:hover { background-color: rgba(46, 191, 140, 0.30); }
.btn--step:disabled { opacity: 0.25; }

/* ------------------------------------------------------------------ broadcast overlay */

/* The overlay starts under the frame's top row, not under the screen's top edge. */
.bcast-body { flex-grow: 1; padding: var(--gap-2); padding-top: var(--frame-top-clear); }

/* One line: stage, leader, clock. It was two (stage over leader, a 74 px clock beside them) and 150 px
   tall; the leader now wraps onto a second small line inside the same height instead. */
.bcast-top {
    flex-direction: row;
    align-items: center;
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    padding: var(--gap-1) var(--gap-3);
    margin-bottom: var(--gap-1);
    min-height: 80px;
}

.bcast-stage { font-size: 44px; -unity-font-style: bold; letter-spacing: 2px; flex-shrink: 0; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); }
.bcast-lead {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--gap-3);
    margin-right: var(--gap-2);
    font-size: 28px;
    white-space: normal;
    color: var(--ink-dim);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}
.bcast-clock { font-size: 60px; min-width: 200px; flex-shrink: 0; -unity-font-style: bold; -unity-text-align: middle-right; text-shadow: 0 2px 5px rgba(0, 0, 0, 0.8); }

.order {
    background-color: var(--overlay-strip);
    border-radius: var(--radius-sm);
    padding: var(--gap-1);
    width: 62%;
}

.order-row {
    flex-direction: row;
    align-items: center;
    height: 52px;           /* BroadcastView.RowPitch is this plus the 2 px gap */
    padding-left: var(--gap-1);
    padding-right: var(--gap-1);
    margin-bottom: 2px;
    border-radius: 6px;
    background-color: var(--row);
    /* A position change slides rather than snaps; see BroadcastView.Reorder. */
    transition-property: translate, background-color, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-in-out;
}

.order-row--lead {
    /* Marked with an accent edge rather than a lighter fill. Lightening the leader's row is the one change
       that hurts exactly the text it is meant to emphasise: an athlete colour is picked to read against
       asphalt, and green or yellow on a pale strip is the least legible row on the board. */
    background-color: rgba(46, 191, 140, 0.14);
    border-left-width: 4px;
    border-left-color: var(--accent);
}
.order-row--gained { background-color: rgba(46, 191, 140, 0.28); }
.order-row--lost { background-color: rgba(255, 108, 92, 0.22); }

.order-rank { width: 60px; font-size: var(--t-small); -unity-font-style: bold; color: var(--ink-dim); }
.order-name {
    flex-grow: 1;
    font-size: var(--t-small);
    -unity-font-style: bold;
    /* An athlete colour is chosen to read against asphalt, not against a bright sky. The shadow is what
       keeps a green or a yellow name legible when the shot cuts to one looking up at the roofline. */
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85);
}
.order-gap { width: 200px; font-size: var(--t-small); -unity-text-align: middle-right; color: var(--ink-dim); }

/* The athlete the viewer has locked the cameras onto. */
.order-row--pinned { border-left-width: 4px; border-left-color: var(--warn); }

/* The athlete on camera, shown under the leaders from further back: set apart so the gap reads. */
.order-row--apart { margin-top: 10px; }

/* "+4 more" / "show fewer": opens the whole order and closes it again. */
.order-more {
    font-size: var(--t-micro);
    letter-spacing: 1px;
    color: var(--accent);
    -unity-font-style: bold;
    padding: 10px var(--gap-1) 6px var(--gap-1);
}

.splits {
    background-color: var(--overlay-strip);
    border-radius: var(--radius-sm);
    padding: var(--gap-1);
    width: 100%;
    margin-top: var(--gap-1);
}

/* The right-hand column beside the running order: the track map, then the splits under it. */
.bcast-right { width: 36%; margin-left: var(--gap-1); }

.bcast-map {
    height: 176px;
    background-color: var(--overlay-strip);
    border-radius: var(--radius-sm);
}

.split-row { font-size: var(--t-micro); color: var(--ink-dim); height: 42px; }

/* The split that has just been set flashes once and settles. */
.split-row--new { color: var(--ink); -unity-font-style: bold; }

.lower-third {
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    padding: var(--gap-2) var(--gap-3);
    /* Clears the HUD's control bar, which lives in a different UIDocument so its height cannot be
       measured from here — one 88 px button plus the bar's own padding, plus room to breathe. Without it
       the lower third is drawn underneath the buttons and half a name shows. The bar now also pads
       itself clear of the frame, so this has to clear both. */
    /* Only the fallback now: BroadcastView.SitOnControls measures the HUD and sets this every frame.
       264 = one 104 px control row + 16 px of padding + the frame clearance. */
    margin-bottom: 264px;
    /* Wipes in from the left rather than fading: it is a graphic being pushed on, not a ghost. */
    transition-property: opacity, translate;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.lower-third--out { opacity: 0; translate: -40px 0; }
.lower-third--in { opacity: 1; translate: 0 0; }
.lower-name { font-size: var(--t-title); -unity-font-style: bold; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85); }
.lower-detail { font-size: var(--t-small); color: var(--ink-dim); }

/* The viewer has locked the cameras onto this athlete (a tap on the card or on a name in the order). */
.lower-pin {
    font-size: var(--t-micro);
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--warn);
    border-width: 2px;
    border-color: var(--warn);
    border-radius: 6px;
    padding: 2px var(--gap-1);
}

/* STATS: the policy and how upright the body is, on the same card. */
.lower-dev { font-size: var(--t-micro); color: var(--ink-dim); margin-top: var(--gap-1); white-space: normal; }

/* A card that is only saying the caption is a slimmer band. */
.lower-third--caption-only { padding-top: var(--gap-1); padding-bottom: var(--gap-1); }

/* Strain: joint torque against drive limit, on the athlete the gallery is on. */
.strain {
    flex-direction: row;
    align-items: center;
    margin-top: var(--gap-1);
}

.strain-track {
    flex-grow: 1;
    height: 14px;
    margin-left: var(--gap-2);
    margin-right: var(--gap-2);
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.10);
    overflow: hidden;
}

/* Width and colour are both set from the reading in BroadcastView; the transition is what keeps a bar
   sampled ten times a second from looking like it is stepping. */
.strain-fill {
    height: 100%;
    width: 0;
    border-radius: 7px;
    background-color: var(--accent);
    transition-property: width, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.strain-value { width: 210px; font-size: var(--t-micro); -unity-text-align: middle-right; color: var(--ink-dim); }

/* ------------------------------------------------------------------ commentary caption
 *
 * The first line of the broadcast card rather than a band of its own above it: one panel along the bottom
 * of the picture, not three stacked.
 */

.caption-text {
    font-size: var(--t-small);
    -unity-font-style: italic;
    -unity-text-align: middle-left;
    white-space: normal;
    color: var(--ink);
    margin-bottom: 4px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85);
}

/* The countdown, dead centre, scaling down on each beep. */
.countdown {
    position: absolute;
    left: 0; right: 0;
    top: 34%;
    font-size: 220px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink);
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.countdown--beat { scale: 1.35 1.35; opacity: 1; }
.countdown--rest { scale: 0.9 0.9; opacity: 0.55; }
.countdown--off { opacity: 0; scale: 0.6 0.6; }

/* ------------------------------------------------------------------ stats card */

.stats { width: 100%; }
.stat-line { flex-direction: row; justify-content: space-between; margin-bottom: var(--gap-1); }
.stat-key { font-size: var(--t-small); color: var(--ink-dim); }
.stat-value { font-size: var(--t-small); -unity-font-style: bold; }

/* ------------------------------------------------------------------ control bar */

.control-bar {
    flex-direction: row;
    align-items: center;
    padding: var(--gap-2);
    /* Same reason as .setup: this bar sits on the bottom edge, and the frame's bottom row is over it. */
    padding-bottom: var(--frame-clear);
}

.control-bar .btn { flex-grow: 1; margin-left: var(--gap-1); margin-right: var(--gap-1); }

/* ------------------------------------------------------------------ modal */

.modal-scrim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: var(--scrim);
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.modal {
    width: 92%;
    max-height: 90%;
    background-color: var(--surface);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-4);
    transition-property: scale, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.modal--out { scale: 0.94 0.94; opacity: 0; }
.modal--in { scale: 1 1; opacity: 1; }

.result-row {
    flex-direction: row;
    align-items: center;
    /* At least 80, and taller when the name carries its race line under it. */
    min-height: 80px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: var(--gap-2);
    padding-right: var(--gap-2);
    border-radius: 6px;
    margin-bottom: var(--gap-1);
    background-color: var(--row);
}

.result-row--podium { background-color: var(--row-lead); }
.result-who { flex-grow: 1; flex-shrink: 1; justify-content: center; }
.result-sub { font-size: var(--t-micro); color: var(--ink-dim); margin-top: -2px; }
.result-rank { width: 88px; font-size: var(--t-title); -unity-font-style: bold; }
.result-name { flex-grow: 1; font-size: var(--t-body); -unity-font-style: bold; }
.result-time { width: 280px; font-size: var(--t-body); -unity-text-align: middle-right; }

/* ------------------------------------------------------------------ setup menu */

/* The bottom padding clears the frame. START is the last thing in this column and is anchored to the
   bottom of a tall screen, so without it the button is drawn under DEBUG and the version number - which
   is exactly how it shipped in v0.1.4. */
.setup {
    padding: var(--gap-4);
    /* Both edges, not just the bottom. The frame's rows are absolute and 112px tall at each end, so a
       screen that pads only one of them puts its own heading underneath the other. This one did: its
       title sat under the game name, the frame-rate readout and MENU, with 32px of clearance against a
       112px bar. The bottom was fixed after v0.1.4 shipped START underneath DEBUG; the top was not. */
    padding-top: var(--frame-clear);
    padding-bottom: var(--frame-clear);
    flex-grow: 1;
}

/* One row of chips, however many events there are: five fit at 28px with the long names wrapping. */
.event-grid { flex-direction: row; flex-wrap: nowrap; margin-bottom: var(--gap-1); }

/* The picked event's own note, under the chips, where the 300 px heading block used to be. */
.setup-hint { font-size: 28px; color: var(--ink-dim); white-space: normal; margin: 0 4px var(--gap-1) 4px; }

.event-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px;
    min-height: 96px;
    padding: 4px;
    white-space: normal;
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.event-btn:hover { background-color: rgba(46, 191, 140, 0.14); }
.event-btn--selected {
    background-color: rgba(46, 191, 140, 0.22);
    border-color: var(--accent);
}

.runner-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    padding: var(--gap-2);
    margin-bottom: var(--gap-2);
}

/* A row at zero is still listed — the roster is the same every time, which is what makes it readable —
   but it is plainly out of the race. */
.runner-row--out { opacity: 0.42; }

.runner-name { flex-grow: 1; font-size: var(--t-body); }
.runner-count {
    width: 96px;
    font-size: var(--t-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.runner-swatch {
    width: 14px;
    height: 64px;
    border-radius: 6px;
    margin-right: var(--gap-2);
}

/* ------------------------------------------------------------------ diagnostics */

.telemetry {
    position: absolute;
    background-color: rgba(4, 6, 11, 0.86);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-2);
    width: 560px;
}

.telemetry-title {
    font-size: var(--t-micro);
    letter-spacing: 3px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-bottom: var(--gap-1);
}

.telemetry-key { font-size: var(--t-micro); color: var(--ink-dim); }
.telemetry-value { font-size: var(--t-micro); -unity-font-style: bold; -unity-text-align: middle-right; }
.telemetry-value--good { color: var(--accent); }
.telemetry-value--warn { color: var(--warn); }
.telemetry-value--bad { color: var(--danger); }

/* The frame-time graph is drawn with generateVisualContent, so this only has to reserve the space. */
.telemetry-graph {
    height: 120px;
    margin-top: var(--gap-1);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

/* ------------------------------------------------------------------ the frame
 *
 * Five fixed positions that every screen shares: name, frame rate, MENU, DEBUG, version. Both rows are
 * absolute so the frame never reflows the screen underneath it, and both are 112 px tall — an 80 px
 * touch target plus 16 px of padding either side.
 *
 * Because the rows are absolute, nothing moves out of their way on its own: any screen that anchors
 * content to the bottom of the display has to pad itself by --frame-clear, and .setup, .control-bar and
 * .lower-third all do. That is not a style preference. v0.1.4 shipped with the setup screen's START
 * button drawn underneath DEBUG and the version number, because this file asserted the clearance existed
 * and no rule anywhere applied it.
 */

.frame-row {
    position: absolute;
    left: 0;
    right: 0;
    height: 112px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--gap-2);
    padding-right: var(--gap-2);
}

.frame-row--top { top: 0; }
.frame-row--bottom { bottom: 0; }

/* Text in the frame sits over the sky, which is the brightest thing in the scene, so every chip carries
   its own ground rather than relying on a shadow. */
.frame-chip {
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    padding: var(--gap-1) var(--gap-2);
    -unity-text-align: middle-center;
}

.frame-title {
    font-size: var(--t-small);
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink);
}

/* Fixed width, so the row does not shuffle sideways every time the frame rate crosses a digit. The frame
   time went to the LIVE page the chip opens, which took it from 440 px to 300. It is grey until it has a reading. */
.frame-fps {
    font-size: var(--t-small);
    -unity-font-style: bold;
    width: 300px;
    color: var(--ink-dim);
}

.frame-fps--good { color: var(--accent); }
.frame-fps--warn { color: var(--warn); }
.frame-fps--bad { color: var(--danger); }

.frame-version {
    font-size: var(--t-micro);
    color: var(--ink-dim);
    letter-spacing: 1px;
}

.frame-btn {
    min-height: 80px;
    min-width: 180px;
    font-size: var(--t-small);
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: var(--gap-1) var(--gap-2);
    background-color: var(--overlay);
}

/* The debug button reports as well as opens: it wears the worst grade the agent panel has found, so a
   config fault is visible from the corner of the screen without opening anything. */
.frame-btn--open { background-color: rgba(46, 191, 140, 0.28); }

/* DEBUG's grade: a dot at the right end of the button, grey with nothing to say. The button makes room
   for it so it never touches the word. */
.frame-btn--dotted { padding-right: 44px; min-width: 200px; }
.frame-dot {
    position: absolute;
    top: 31px;
    right: 14px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--ink-faint);
}
.frame-dot--good { background-color: var(--accent); }
.frame-dot--warn { background-color: var(--warn); }
.frame-dot--bad { background-color: var(--danger); }

/* ------------------------------------------------------------------ diagnostics sheet
 *
 * The old panel was a 560 px card pinned to the top-left corner with 18 px text in it — a desktop
 * overlay, on a screen held in one hand. This is a sheet instead: it comes up from the bottom over most
 * of the picture, it scrolls, and everything in it is readable at arm's length.
 */

.sheet-scrim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(3, 5, 9, 0.72);
}

.sheet {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    top: 96px;
    background-color: rgba(8, 10, 17, 0.97);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-3);
}

.sheet-head { flex-direction: row; align-items: center; margin-bottom: var(--gap-2); }

.sheet-tabs { flex-direction: row; margin-bottom: var(--gap-2); }

.tab {
    flex-grow: 1;
    min-height: 80px;
    font-size: var(--t-small);
    -unity-font-style: bold;
    letter-spacing: 2px;
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-width: 0;
    color: var(--ink-dim);
    margin-right: var(--gap-1);
}

.tab--on { background-color: rgba(46, 191, 140, 0.22); color: var(--ink); }

/* The line under the tabs: the field in a sentence, graded by its colour; an export's result for a moment. */
.sheet-summary { font-size: 28px; white-space: normal; color: var(--ink-dim); margin-bottom: var(--gap-2); }
.sheet-summary--good { color: var(--accent); }
.sheet-summary--warn { color: var(--warn); }
.sheet-summary--bad { color: var(--danger); }

/* ------------------------------------------------------------------ one agent's card */

.agent {
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-left-width: 6px;
    border-left-color: var(--ink-faint);
    padding: var(--gap-2);
    margin-bottom: var(--gap-2);
}

.agent--good { border-left-color: var(--accent); }
.agent--warn { border-left-color: var(--warn); }
.agent--bad { border-left-color: var(--danger); }

.agent-name { font-size: var(--t-body); -unity-font-style: bold; }

/* The ONNX file driving this body right now. Small, but never hidden: "which checkpoint am I watching"
   is the question the whole panel exists to stop somebody guessing at. */
.agent-model {
    font-size: var(--t-micro);
    color: var(--ink-dim);
    white-space: normal;
    margin-bottom: var(--gap-1);
}

/* Three metrics to a row, each a big number over its name, so the card is scannable rather than read. */
.metric-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--gap-1); }

.metric {
    width: 33%;
    padding-top: var(--gap-1);
    padding-bottom: var(--gap-1);
}

.metric-value { font-size: var(--t-body); -unity-font-style: bold; }
.metric-value--good { color: var(--accent); }
.metric-value--warn { color: var(--warn); }
.metric-value--bad { color: var(--danger); }
.metric-key { font-size: var(--t-micro); color: var(--ink-faint); letter-spacing: 1px; }

/* Speed and uprightness over the last ninety seconds, drawn in AgentCard.DrawTrend. */
.agent-trend {
    height: 130px;
    margin-top: var(--gap-1);
    margin-bottom: var(--gap-1);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

.agent-legend { font-size: var(--t-micro); color: var(--ink-faint); margin-bottom: var(--gap-1); white-space: normal; }

/* The sentence. This is the payload of the whole panel: what to change, in words. */
.agent-verdict {
    font-size: var(--t-small);
    white-space: normal;
    color: var(--ink);
}

/* ------------------------------------------------------------------ field grid (setup)
 *
 * One tile per roster entry, three across, sized in SetupView.FitTiles to the height left under the
 * events and above START, so the whole menu is one portrait screen and nothing scrolls.
 */

.runner-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: flex-start;
}

.runner-tile {
    width: 31.3%;
    margin: 8px 1%;
    min-height: 150px;
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-top-width: 8px;
    border-top-color: var(--ink-faint);
    overflow: hidden;
}

.runner-tile--out { opacity: 0.42; }

/* The face fills what the name and the best mark leave; the tile's controls sit in its corners. */
.runner-tile-face {
    flex-grow: 1;
    -unity-background-scale-mode: scale-and-crop;
}

.runner-tile-name {
    font-size: var(--t-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 4px;
}

.runner-tile-best {
    font-size: var(--t-micro);
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    margin-bottom: var(--gap-1);
}

/* How many of this athlete are in the field, top right over the face. */
.runner-tile-count {
    position: absolute;
    top: 8px;
    right: 8px;
    min-width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: var(--overlay);
    font-size: var(--t-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* The minus (top left) and the "i" (bottom left): round, over the face, each an 80 px target. */
.runner-tile-chip {
    position: absolute;
    width: 80px;
    height: 80px;
    min-height: 80px;
    margin: 0;
    padding: 0;
    border-radius: 40px;
    border-width: 0;
    background-color: var(--overlay);
    color: var(--ink);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.runner-tile-chip:hover { background-color: rgba(46, 191, 140, 0.45); }
.runner-tile-chip:disabled { opacity: 0.3; }
.runner-tile-minus { top: 8px; left: 8px; }
.runner-tile-info { bottom: 8px; left: 8px; font-size: 40px; -unity-font-style: bold-and-italic; }

/* ------------------------------------------------------------------ results without a scroll bar */

.results-rows { flex-grow: 1; justify-content: center; }

/* Everybody who did not finish, one line (wrapping) under the finishers' rows. */
.results-dnf {
    font-size: 28px;
    color: var(--ink-dim);
    white-space: normal;
    padding: var(--gap-1) var(--gap-2);
    margin-bottom: var(--gap-1);
    border-radius: 6px;
    background-color: var(--row);
}

.result-row--compact { min-height: 58px; height: 58px; padding-top: 0; padding-bottom: 0; margin-bottom: 4px; }
.result-row--compact .result-rank { font-size: var(--t-small); width: 64px; }
.result-row--compact .result-name { font-size: var(--t-small); }
.result-row--compact .result-time { font-size: var(--t-small); width: 220px; }

/* ------------------------------------------------------------------ one control row (HUD)
 *
 * The viewer's disturbances and the race's own buttons share one row: each is an icon over one word, so
 * seven fit across 1080 px at 104 px tall. This was two stacked bars, 352 px of a 1920 px screen.
 */

.chaos-group { flex-direction: row; flex-grow: 2; flex-basis: 0; }
.chaos-group .btn { flex-grow: 1; flex-basis: 0; margin-left: 4px; margin-right: 4px; }

.btn--tool {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 104px;
    padding: 4px;
    font-size: var(--t-micro);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.control-bar .btn--tool { flex-grow: 1; flex-basis: 0; margin-left: 4px; margin-right: 4px; }

/* Over the picture a 6% white ghost disappears into the sky; the controls carry the overlay ground. */
.control-bar .btn--ghost, .chaos-group .btn { background-color: var(--overlay); }

.btn--tool .btn-icon { width: 48px; height: 48px; margin-right: 0; margin-bottom: 4px; }

/* GUST / SHOVE / SLICK, in a row CHAOS pops up over the control row. */
.chaos-pop { flex-direction: row; padding: 0 var(--gap-2); margin-bottom: 4px; }
.chaos-pop .btn { flex-grow: 1; flex-basis: 0; margin-left: 4px; margin-right: 4px; background-color: var(--overlay); border-width: 2px; border-color: var(--warn); }

/* A toggle that is on (CHAOS open, STATS on), and RESTART waiting for its second tap. Two classes each,
   so they win over the overlay ground the control row gives every ghost button. */
.control-bar .btn--on { background-color: rgb(22, 104, 78); border-width: 2px; border-color: var(--accent); }
.control-bar .btn--armed { background-color: rgb(120, 92, 30); border-width: 2px; border-color: var(--warn); }
.btn--tool .btn-label { font-size: var(--t-micro); letter-spacing: 1px; }
.btn-icon--dark { -unity-background-image-tint-color: rgb(6, 20, 15); }
.btn-label--dark { color: rgb(6, 20, 15); }

/* ------------------------------------------------------------------ stats badges (HUD) */

.badge-strip {
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    padding: var(--gap-1);
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.badge-row { flex-direction: row; }

.badge {
    flex-grow: 1;
    flex-basis: 0;
    margin: 2px;
    padding: 4px var(--gap-1);
    border-radius: 6px;
    background-color: var(--row-lead);
    font-size: var(--t-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.badge-model { font-size: var(--t-micro); color: var(--ink-dim); margin: 2px var(--gap-1); }

/* A button that is an icon over a word rather than a word alone. */
.btn--icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: var(--gap-1);
    padding-right: var(--gap-1);
}

.btn-icon {
    width: 44px;
    height: 44px;
    margin-right: var(--gap-1);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.btn-label { font-size: var(--t-small); -unity-font-style: bold; color: var(--ink); }
.btn:disabled .btn-label { color: var(--ink-faint); }

/* ------------------------------------------------------------------ results: points, season, clip */

.result-points {
    width: 150px;
    font-size: var(--t-small);
    -unity-text-align: middle-right;
    color: var(--accent);
    -unity-font-style: bold;
}

.result-row--compact .result-points { width: 120px; font-size: var(--t-micro); }

/* The personal-best badge beside a name: a small star. */
.pb-badge {
    width: 34px;
    height: 34px;
    margin-left: var(--gap-1);
    background-image: url('project://database/Assets/UI/Icons/star.png');
    -unity-background-image-tint-color: var(--warn);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.season-panel {
    margin-top: var(--gap-2);
    padding: var(--gap-2);
    border-radius: var(--radius-sm);
    background-color: var(--row);
}

.season-head { flex-direction: row; align-items: center; margin-bottom: var(--gap-1); }

.season-icon {
    width: 40px;
    height: 40px;
    margin-right: var(--gap-1);
    background-image: url('project://database/Assets/UI/Icons/trophy.png');
    -unity-background-image-tint-color: var(--warn);
    -unity-background-scale-mode: scale-to-fit;
}

.season-title { font-size: var(--t-small); -unity-font-style: bold; flex-grow: 1; }
.season-line { flex-direction: row; height: 44px; align-items: center; }
.season-rank { width: 56px; font-size: var(--t-small); color: var(--ink-dim); }
.season-name { flex-grow: 1; font-size: var(--t-small); -unity-font-style: bold; }
.season-total { width: 170px; font-size: var(--t-small); -unity-text-align: middle-right; }

/* What SHARE did, or why there is no clip on this device. */
.clip-text { font-size: var(--t-micro); color: var(--ink-dim); white-space: normal; margin-top: var(--gap-1); }


/* ------------------------------------------------------------------ results: replay and actions */

/* The highlight clip, looping full-bleed behind the card (ResultsView.TickReplay). */
.replay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(0, 0, 0);
}

/* With a replay behind it the scrim lets the race through; REPLAY takes the card away altogether and a tap
   on the picture brings it back. */
.modal-scrim--replay { background-color: rgba(5, 7, 12, 0.8); }
.modal-scrim--watch { display: none; }

.results-actions { margin-top: var(--gap-2); }
.results-actions .btn--tool { flex-grow: 1; flex-basis: 0; margin-left: 4px; margin-right: 4px; }

/* ------------------------------------------------------------------ setup: one action row, flipping tiles */

.setup-actions { margin-top: var(--gap-1); }
.setup-actions .btn--tool { flex-grow: 1; flex-basis: 0; margin-right: var(--gap-1); }
.setup-start { flex-grow: 2; flex-basis: 0; min-height: 104px; flex-direction: column; align-items: center; justify-content: center; padding: 4px; }
.setup-start-word { font-size: 40px; -unity-font-style: bold; color: rgb(6, 20, 15); }
.setup-start-detail { font-size: var(--t-micro); color: rgb(6, 20, 15); }

/* A tile turned over to show the athlete's record: the card covers the face, the count and the minus go,
   the "i" stays to turn it back. */
.runner-tile-card {
    position: absolute;
    /* Two pixels past the face on every side: flush, the photo's edge showed as a sliver round the card. */
    left: -2px; right: -2px; top: -2px; bottom: -2px;
    padding: 8px 8px 88px 8px;
    font-size: var(--t-micro);
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgb(24, 44, 44);
}
.runner-tile--flipped .runner-tile-count, .runner-tile--flipped .runner-tile-minus { display: none; }

/* ------------------------------------------------------------------ diagnostics: no scroll, three pages */

/* The sheet and its scrim stop at the frame's rows, so MENU, the frame rate, DEBUG and the version stay on
   the picture while it is open, and DEBUG closes what it opened. */
.sheet { top: var(--frame-row); bottom: var(--frame-row); border-bottom-left-radius: var(--radius); border-bottom-right-radius: var(--radius); }
.sheet-scrim { top: var(--frame-row); bottom: var(--frame-row); }
.sheet-body { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.sheet-head .sheet-tabs { flex-grow: 1; margin-bottom: 0; }
.sheet-head .btn--chip { margin-left: var(--gap-1); }
.btn--icon-only { width: 96px; min-width: 96px; padding: 0; align-items: center; justify-content: center; }
.btn--icon-only .btn-icon { margin: 0; }

/* One athlete per line on the AGENTS list; tapping one opens its full card. */
.agent-row {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    margin: 0 0 4px 0;
    padding: 4px var(--gap-2);
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-left-width: 6px;
    border-left-color: var(--ink-faint);
}
.agent-row--good { border-left-color: var(--accent); }
.agent-row--warn { border-left-color: var(--warn); }
.agent-row--bad { border-left-color: var(--danger); }
.agent-row-name { flex-grow: 1; flex-shrink: 1; font-size: var(--t-small); -unity-font-style: bold; -unity-text-align: middle-left; overflow: hidden; }
.agent-row-cell { width: 150px; font-size: var(--t-micro); -unity-text-align: middle-right; color: var(--ink-dim); }
/* "!" on a line whose card has something that needs acting on. */
.agent-row-flag { width: 28px; font-size: var(--t-small); -unity-font-style: bold; color: var(--danger); -unity-text-align: middle-left; }
/* Past eight athletes the lines go compact, so sixteen leave room for the frame grid under them. */
.agent-row--compact { min-height: 50px; padding-top: 0; padding-bottom: 0; margin-bottom: 2px; }

/* The device half of the LIVE page: the frame-time graph, then every counter four across. */
.frame-section { margin-top: var(--gap-2); }
.frame-grid { flex-direction: row; flex-wrap: wrap; margin-top: var(--gap-1); }
.frame-cell { width: 25%; padding: 6px 4px; }
.frame-cell .telemetry-value { font-size: 30px; -unity-text-align: middle-left; white-space: normal; }
.frame-cell .telemetry-key { white-space: normal; }
.agent-back { align-self: flex-start; margin-left: 0; margin-bottom: var(--gap-2); }

.settings-row { margin-left: -4px; margin-right: -4px; }

/* ------------------------------------------------------------------ results: photo finish */

.photo-finish { margin-bottom: var(--gap-2); }
.photo-strip {
    height: 150px;
    border-radius: 6px;
    background-color: rgb(20, 20, 24);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--surface-line);
}
.photo-caption { font-size: var(--t-micro); color: var(--ink-dim); margin-top: 4px; }
