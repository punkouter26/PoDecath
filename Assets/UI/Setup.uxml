<?xml version="1.0" encoding="utf-8"?>
<!--
    The event setup menu: pick the event, then pick who runs it.

    Both grids are built in SetupView from the scenes and athlete definitions the project actually has, so
    an event that has not been built and a policy that has not been trained simply do not appear.

    Everything fits one portrait screen. The events are one row of chips and the field is a grid of tiles
    (three across) sized in code to the height that is left, so nothing here scrolls: a menu that has to be
    scrolled to find START is a menu with a hidden button.

    No heading block. "EVENT SETUP", a sentence under it and an EVENT label took 300 px to say what the
    highlighted chip already says; one line under the chips carries the event's own note, and START carries
    the rest ("8 runners").

    Each tile is the athlete's face (PoDecath/Bake Athlete Portraits), their name, and their best mark in
    the picked event. Tap the tile to add one runner; the minus in the corner takes one off; the count sits
    in the other corner. The "i" turns the tile over to show that athlete's record on this device, and a
    tap on the back turns it round again.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="safe" class="safe">
            <ui:VisualElement class="setup">

                <ui:VisualElement name="events" class="event-grid" />
                <ui:Label name="hint" class="setup-hint" text="" />

                <ui:VisualElement name="runners" class="runner-grid" />

                <ui:VisualElement class="row setup-actions">
                    <ui:Button name="none" class="btn btn--ghost btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/cross.png');" />
                        <ui:Label class="btn-label" text="NONE" />
                    </ui:Button>
                    <ui:Button name="all" class="btn btn--ghost btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/multiplayer.png');" />
                        <ui:Label class="btn-label" text="ONE EACH" />
                    </ui:Button>
                    <!-- A season runs every event in decathlon order with this field and keeps a points table. -->
                    <ui:Button name="season" class="btn btn--ghost btn--tool">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/trophy.png');" />
                        <ui:Label name="season-label" class="btn-label" text="SEASON" />
                    </ui:Button>
                    <ui:Button name="season-reset" class="btn btn--ghost btn--tool hidden">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/cross.png');" />
                        <ui:Label name="season-reset-label" class="btn-label" text="END" />
                    </ui:Button>
                    <ui:Button name="start" class="btn btn--primary setup-start">
                        <ui:Label class="setup-start-word" text="START" />
                        <ui:Label name="start-detail" class="setup-start-detail" text="" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
