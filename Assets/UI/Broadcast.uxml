<?xml version="1.0" encoding="utf-8"?>
<!--
    The furniture a televised event carries over the picture, top to bottom:

        top strip      the event, where it has got to, the clock
        left column    the running order
        right column   the track map (every athlete as a dot on the loop), then the splits board
        bottom         the commentary caption, then the lower third for whoever is on camera

    Only the containers are declared here; the rows in the running order and the splits board are made in
    BroadcastView from a count that depends on the field, and the map is painted with the mesh API.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="safe" class="safe" style="padding: 16px;">

            <!-- Top bar: what the event is, where it has got to, and the clock. -->
            <ui:VisualElement name="top-bar" class="bcast-top">
                <ui:VisualElement class="col fill">
                    <ui:Label name="stage" class="bcast-stage" text="100 M" />
                    <ui:Label name="lead" class="bcast-lead" text="" />
                </ui:VisualElement>
                <ui:Label name="clock" class="bcast-clock" text="0.00" style="min-width: 260px;" />
            </ui:VisualElement>

            <!-- Running order on the left, map and splits stacked on the right. -->
            <ui:VisualElement class="row" style="align-items: flex-start;">
                <ui:VisualElement name="order" class="order">
                    <ui:Label class="label-micro" text="ORDER" style="margin-left: 8px; margin-bottom: 4px;" />
                    <ui:VisualElement name="order-rows" />
                    <ui:Label name="overflow" class="label-micro hidden" text="" style="margin-left: 8px;" />
                </ui:VisualElement>

                <ui:VisualElement name="right" class="bcast-right">
                    <ui:VisualElement name="track-map" class="bcast-map" />

                    <ui:VisualElement name="splits" class="splits">
                        <ui:Label class="label-micro" text="SPLITS" style="margin-left: 8px; margin-bottom: 4px;" />
                        <ui:VisualElement name="split-rows" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="spacer" />

            <!--
                What the commentary is saying. Always drawn, on every platform: most of them have no system
                voice at all, and a caption is the only part of the commentary that survives the sound
                being off or a screenshot being taken.
            -->
            <ui:VisualElement name="caption" class="caption caption--out">
                <ui:Label name="caption-text" class="caption-text" text="" />
            </ui:VisualElement>

            <!-- Lower third: who the gallery has cut to. Wipes in from the left on every cut. -->
            <ui:VisualElement name="lower-third" class="lower-third lower-third--out">
                <ui:Label name="lower-name" class="lower-name" text="" />
                <ui:Label name="lower-detail" class="lower-detail" text="" />

                <!--
                    Strain: the featured athlete's joint torque as a fraction of what its drives are
                    allowed to produce. The fill is the reading; the tick behind it is where fatigue has
                    got to. Hidden on an athlete with no effort meter.
                -->
                <ui:VisualElement name="strain" class="strain">
                    <ui:Label class="label-micro" text="STRAIN" />
                    <ui:VisualElement name="strain-track" class="strain-track">
                        <ui:VisualElement name="strain-fill" class="strain-fill" />
                    </ui:VisualElement>
                    <ui:Label name="strain-value" class="strain-value" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Outside the safe area on purpose: the countdown is centred on the picture, not on the layout. -->
        <ui:Label name="countdown" class="countdown countdown--off" text="3" />
    </ui:VisualElement>
</ui:UXML>
