<?xml version="1.0" encoding="utf-8"?>
<!--
    The diagnostics sheet, opened by DEBUG in the bottom-left of the frame, by tapping the frame rate in the
    top-centre (straight onto FRAME), or F3 on a desktop.

    Three pages:

      AGENTS    are the policies doing what they were trained to? One line per athlete; tap a line for that
                athlete's full card (which ONNX is driving it, nine numbers, ninety seconds of trend, and
                one sentence saying what to change), BACK for the list.
      FRAME     is the device keeping up? Frame time, draw calls, memory, GC.
      SETTINGS  the quality tier and the frame-rate target. These lived on a separate evaluation screen
                whose third control, the checkpoint picker, was read by nothing at all.

    Nothing here scrolls. The AGENTS page was one full card per athlete in a scroll view, 8457 px of content
    in a 1500 px sheet for a field of eight; a list with one card open at a time is the same information
    without a scroll bar.

    The sheet and its scrim stop at the frame's rows top and bottom, so MENU, DEBUG, the frame rate and the
    version stay on the picture and DEBUG closes what it opened.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root hidden">
        <ui:VisualElement name="scrim" class="sheet-scrim" />
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore">
            <ui:VisualElement name="panel" class="sheet">

                <ui:VisualElement class="sheet-head">
                    <ui:Label name="title" class="label-micro" text="TELEMETRY" style="flex-grow: 1;" />
                    <ui:Button name="export" class="btn btn--ghost btn--chip" text="EXPORT" />
                    <ui:Button name="close" class="btn btn--ghost btn--chip" text="CLOSE" />
                </ui:VisualElement>

                <!-- Where the last export landed. Empty until EXPORT is pressed, because a permanent file
                     path across the top of a diagnostics panel is furniture, not information. -->
                <ui:Label name="export-note" class="agent-legend" text="" style="white-space: normal;" />

                <ui:VisualElement class="sheet-tabs">
                    <ui:Button name="tab-agents" class="tab tab--on" text="AGENTS" />
                    <ui:Button name="tab-frame" class="tab" text="FRAME" />
                    <ui:Button name="tab-settings" class="tab" text="SETTINGS" />
                </ui:VisualElement>

                <ui:VisualElement name="body" class="sheet-body">

                    <ui:VisualElement name="agents-page">
                        <ui:Label name="headline" class="headline" text="" />
                        <ui:VisualElement name="agents" />
                        <ui:VisualElement name="agent-detail" class="hidden">
                            <ui:Button name="agent-back" class="btn btn--ghost btn--chip agent-back" text="BACK TO THE FIELD" />
                            <ui:VisualElement name="agent-card" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="frame-page" class="hidden">
                        <ui:VisualElement name="rows" />
                        <ui:VisualElement name="graph" class="telemetry-graph" />
                        <ui:Label name="footer" class="telemetry-key" text="" style="margin-top: 8px; white-space: normal;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="settings-page" class="hidden">
                        <ui:Label class="label-micro" text="QUALITY TIER" style="margin-bottom: 8px;" />
                        <ui:VisualElement class="row settings-row">
                            <ui:Button name="tier-mobile" class="event-btn" text="MOBILE" />
                            <ui:Button name="tier-pc" class="event-btn" text="PC" />
                        </ui:VisualElement>
                        <ui:Label name="tier-note" class="agent-legend" text="" style="white-space: normal;" />

                        <ui:Label class="label-micro" text="FRAME-RATE TARGET" style="margin-top: 24px; margin-bottom: 8px;" />
                        <ui:VisualElement class="row settings-row">
                            <ui:Button name="fps-30" class="event-btn" text="30 FPS" />
                            <ui:Button name="fps-60" class="event-btn" text="60 FPS" />
                        </ui:VisualElement>

                        <ui:Label name="settings-info" class="agent-legend" text="" style="margin-top: 24px; white-space: normal;" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
