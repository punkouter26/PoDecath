<?xml version="1.0" encoding="utf-8"?>
<!--
    The event setup menu: pick the event, then pick who runs it.

    Both grids are built in SetupView from the scenes and athlete definitions the project actually has, so
    an event that has not been built and a policy that has not been trained simply do not appear.

    Everything fits one portrait screen. The events are one row of chips and the field is a grid of tiles
    (three across) sized in code to the height that is left, so nothing here scrolls: a menu that has to be
    scrolled to find START is a menu with a hidden button.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="safe" class="safe">
            <ui:VisualElement class="setup">

                <!-- No game name here. AppFrame prints it in the top left of every screen, so this was
                     the second copy of it, directly underneath the first. -->
                <ui:Label name="title" class="label-display" text="EVENT SETUP" />
                <ui:Label name="hint" class="label-small muted" text="" style="margin-bottom: 16px; white-space: normal;" />

                <ui:Label class="label-micro" text="EVENT" style="margin-bottom: 8px;" />
                <ui:VisualElement name="events" class="event-grid" />

                <ui:VisualElement class="row" style="margin-bottom: 8px;">
                    <ui:Label class="label-micro" text="FIELD" style="flex-grow: 1;" />
                    <ui:Label name="total" class="label-small muted" text="Total 0 / 16" />
                </ui:VisualElement>
                <ui:VisualElement name="runners" class="runner-grid" />

                <ui:VisualElement class="row" style="margin-top: 8px;">
                    <ui:Button name="none" class="btn btn--ghost" text="NONE" style="flex-grow: 1; margin-right: 8px;" />
                    <ui:Button name="all" class="btn btn--ghost" text="ONE EACH" style="flex-grow: 1; margin-right: 8px;" />
                    <ui:Button name="start" class="btn btn--primary" text="START" style="flex-grow: 2; min-height: 104px; font-size: 40px;" />
                </ui:VisualElement>

                <!-- A season runs every event in decathlon order with this field and keeps a points table;
                     the cards are every athlete's record on this device. -->
                <ui:VisualElement class="setup-extra">
                    <ui:Button name="cards" class="btn btn--ghost btn--icon">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/leaderboardsSimple.png');" />
                        <ui:Label class="btn-label" text="CARDS" />
                    </ui:Button>
                    <ui:Button name="season" class="btn btn--ghost btn--icon" style="flex-grow: 2;">
                        <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/UI/Icons/trophy.png');" />
                        <ui:Label name="season-label" class="btn-label" text="START SEASON" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The athlete cards: one per roster entry, filled by SetupView from SeasonStore. -->
        <ui:VisualElement name="cards-sheet" class="modal-scrim hidden">
            <ui:VisualElement class="modal" style="max-height: 86%;">
                <ui:Label class="label-title" text="ATHLETE CARDS" />
                <ui:Label name="cards-hint" class="label-small muted" text="" style="margin-bottom: 16px; white-space: normal;" />
                <ui:VisualElement name="cards-list" class="cards-list" />
                <ui:VisualElement class="row" style="margin-top: 16px;">
                    <ui:Button name="season-reset" class="btn btn--ghost" text="END SEASON" style="flex-grow: 1; margin-right: 8px;" />
                    <ui:Button name="cards-close" class="btn btn--primary" text="CLOSE" style="flex-grow: 1; margin-left: 8px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
